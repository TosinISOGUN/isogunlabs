---
import { contact } from '../data/nav';
import { industriesFor } from '../i18n/industry-labels';
import { pageLang } from '../i18n';
import { l } from '../i18n/config';
import SocialLinks from './SocialLinks.astro';

const { lang, t } = pageLang(Astro.url.pathname);
const f = t.ui.footer;
const industries = industriesFor(lang);
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="logo" href={l(lang, '/')} aria-label={t.ui.homeLabel}>
          <img src="/assets/logo-wordmark.webp" width="203" height="46" alt="Isogun Labs" loading="lazy" />
        </a>
        <p>{f.tagline}</p>
        <div class="partner-row">
          <img class="partner-badge" src="/assets/icons/atlassian_partner_logo/atlassian-partner-attribution-inverse-rgb-2x.png" alt="Atlassian Marketplace Partner" width="93" height="40" loading="lazy" />
          <a class="badge-chip" href="https://saasbrowser.com/en/saas/1616434/isogun-labs" target="_blank" rel="noopener">
            <img src="https://files.saasbrowser.com/tws6r23wwsdv70ni3bn7o18p4op6" alt="Isogun Labs, SaaS Browser verified badge" width="36" height="24" loading="lazy" />
          </a>
        </div>
        <SocialLinks />
      </div>
      <div class="foot-col">
        <h4>{f.studio}</h4>
        <a href={l(lang, '/services/')}>{t.ui.nav.services}</a>
        <a href={l(lang, '/work/')}>{t.ui.nav.work}</a>
        <a href={l(lang, '/about/')}>{t.ui.nav.about}</a>
        <a href="/blog/">{t.ui.nav.blog}</a>
        <a href={l(lang, '/contact/')}>{t.ui.cta}</a>
      </div>
      <div class="foot-col">
        <h4>{f.websitesFor}</h4>
        {industries.map((i) => <a href={l(lang, `/services/${i.slug}/`)}>{i.anchor}</a>)}
      </div>
      <div class="foot-col">
        <h4>{f.atlassian}</h4>
        <a href="https://recap.isogunlabs.com/">{f.recap}</a>
        <a href="https://field-hygiene.isogunlabs.com/">{f.fieldHygiene}</a>
        <a href="https://passdown.isogunlabs.com/">{f.passdown}</a>
        <a href={l(lang, '/get-started/')}>{f.chooser}</a>
        <a href={l(lang, '/documentation/')}>{f.docs}</a>
        <a href={l(lang, '/support/')}>{f.support}</a>
      </div>
      <div class="foot-col">
        <h4>{f.contact}</h4>
        <a href={`mailto:${contact.projectEmail}`}>{contact.projectEmail}</a>
        <a href={contact.booking} target="_blank" rel="noopener">{f.bookCall}</a>
        <a href={contact.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
        <a href={`mailto:${contact.supportEmail}`}>{f.appSupport}</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>{f.rights}</span>
    </div>
  </div>
</footer>
