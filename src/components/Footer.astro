---
import { contact } from '../data/nav';
import SocialLinks from './SocialLinks.astro';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="logo" href="/" aria-label="Isogun Labs, home">
          <img src="/assets/logo-wordmark.webp" width="203" height="46" alt="Isogun Labs" loading="lazy" />
        </a>
        <p>A tech studio building websites, web apps and Atlassian Marketplace apps for startups, businesses and brands.</p>
        <div class="partner-row">
          <img class="partner-badge" src="/assets/icons/atlassian_partner_logo/atlassian-partner-attribution-inverse-rgb-2x.png" alt="We are a partner in the Atlassian Marketplace" width="93" height="40" loading="lazy" />
          <a class="badge-chip" href="https://saasbrowser.com/en/saas/1616434/isogun-labs" target="_blank" rel="noopener">
            <img src="https://files.saasbrowser.com/tws6r23wwsdv70ni3bn7o18p4op6" alt="Isogun Labs, SaaS Browser verified badge" width="36" height="24" loading="lazy" />
          </a>
        </div>
        <SocialLinks />
      </div>
      <div class="foot-col">
        <h4>Studio</h4>
        <a href="/services/">Services</a>
        <a href="/work/">Work</a>
        <a href="/#about">About</a>
        <a href="/blog/">Blog</a>
        <a href="/contact/">Start a project</a>
      </div>
      <div class="foot-col">
        <h4>Atlassian apps</h4>
        <a href="https://recap.isogunlabs.com/">Recap for Jira</a>
        <a href="https://field-hygiene.isogunlabs.com/">Field Hygiene for Jira</a>
        <a href="https://passdown.isogunlabs.com/">Passdown for JSM</a>
        <a href="/get-started/">Product chooser</a>
        <a href="/documentation/">Documentation</a>
        <a href="/support/">Support &amp; SLA</a>
      </div>
      <div class="foot-col">
        <h4>Contact</h4>
        <a href={`mailto:${contact.projectEmail}`}>{contact.projectEmail}</a>
        <a href={contact.booking} target="_blank" rel="noopener">Book a call</a>
        <a href={contact.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
        <a href={`mailto:${contact.supportEmail}`}>App support</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>&copy; 2026 Isogun Labs. All rights reserved.</span>
    </div>
  </div>
</footer>
