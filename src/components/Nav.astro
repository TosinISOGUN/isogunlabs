---
import { navLinks, ctaLabel, ctaHref } from '../data/nav';
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => !href.includes('#') && (path === href || (href !== '/' && path.startsWith(href)));
---
<header class="site-header">
  <div class="island">
    <a class="logo" href="/" aria-label="Isogun Labs, home">
      <img src="/assets/logo-wordmark.webp" width="150" height="34" alt="Isogun Labs" />
    </a>
    <nav class="nav-links" aria-label="Main">
      <span class="nav-blob" aria-hidden="true"></span>
      {navLinks.map((l) => (
        <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <a class="btn btn-lime btn-sm nav-cta" href={ctaHref}>{ctaLabel} <Icon name="arrow-right" /></a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-sheet">Menu</button>
  </div>
</header>

<div class="sheet" id="menu-sheet" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="sheet-top">
    <a class="logo" href="/" aria-label="Isogun Labs, home">
      <img src="/assets/logo-wordmark.webp" width="176" height="40" alt="Isogun Labs" />
    </a>
    <button class="sheet-close" type="button"><Icon name="x" /> Close</button>
  </div>
  <nav aria-label="Menu">
    {navLinks.map((l) => (
      <a href={l.href}>{l.label} <Icon name="arrow-up-right" /></a>
    ))}
  </nav>
  <div class="sheet-foot">
    <a class="btn btn-ink" href={ctaHref}>{ctaLabel} <Icon name="arrow-right" /></a>
    <SocialLinks />
  </div>
</div>
