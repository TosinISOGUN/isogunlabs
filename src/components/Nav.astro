---
import { navLinks, ctaLabel, ctaHref } from '../data/nav';
import { industries } from '../data/industries';
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => !href.includes('#') && (path === href || (href !== '/' && path.startsWith(href)));
---
<header class="site-header">
  <div class="island">
    <a class="logo" href="/" aria-label="Isogun Labs, home">
      <img src="/assets/logo-wordmark.webp" width="150" height="34" alt="Isogun Labs" fetchpriority="high" />
    </a>
    <nav class="nav-links" aria-label="Main">
      <span class="nav-blob" aria-hidden="true"></span>
      {navLinks.map((l) => l.menu ? (
        <div class="nav-item has-menu">
          <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined} aria-haspopup="true">{l.label}</a>
          <div class="mega">
            <div class="mega-list">
              {industries.map((i) => (
                <a class="mega-item" href={`/services/${i.slug}/`} data-preview={i.slug} aria-current={path === `/services/${i.slug}/` ? 'page' : undefined}>
                  <span class="mi-icon"><Icon name={i.icon} /></span>
                  <span class="mi-text"><b>{i.anchor}</b><small>{i.menuText}</small></span>
                </a>
              ))}
              <a class="mega-item mega-all" href="/services/" data-preview="all-services">
                <span class="mi-icon"><Icon name="squares-four" /></span>
                <span class="mi-text"><b>All services</b><small>Web design, web apps and online stores</small></span>
              </a>
            </div>
            <div class="mega-preview" aria-hidden="true">
              {[...industries.map((i) => ({ slug: i.slug, ...i.preview })), { slug: 'all-services', tag: 'All services', title: 'Web design, web apps and online stores' }].map((p) => (
                <figure class="mp" data-for={p.slug}>
                  <img data-src={`/assets/menu/${p.slug}.webp`} alt="" width="960" height="720" decoding="async" />
                  <span class="mp-tag">{p.tag}</span>
                  <figcaption>{p.title}</figcaption>
                </figure>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <a class="btn btn-lime btn-sm nav-cta" href={ctaHref}>{ctaLabel} <Icon name="arrow-right" /></a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-sheet">Menu</button>
  </div>
</header>

<div class="sheet" id="menu-sheet" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="sheet-top">
    <a class="logo" href="/" aria-label="Isogun Labs, home">
      <img src="/assets/logo-wordmark.webp" width="176" height="40" alt="Isogun Labs" />
    </a>
    <button class="sheet-close" type="button"><Icon name="x" /> Close</button>
  </div>
  <nav aria-label="Menu">
    {navLinks.map((l) => (
      <>
        <a href={l.href}>{l.label} <Icon name="arrow-up-right" /></a>
        {l.menu && (
          <div class="sheet-sub">
            {industries.map((i) => <a href={`/services/${i.slug}/`}>{i.anchor}</a>)}
          </div>
        )}
      </>
    ))}
  </nav>
  <div class="sheet-foot">
    <a class="btn btn-ink" href={ctaHref}>{ctaLabel} <Icon name="arrow-right" /></a>
    <SocialLinks />
  </div>
</div>
