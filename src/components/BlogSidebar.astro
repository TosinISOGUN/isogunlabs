---
// No newsletter capture on purpose: a real one needs an email service and stored addresses.
// This uses a plain link to the contact page instead.
import { blogUi } from '../i18n/blog-ui';
import { l, type Locale } from '../i18n/config';
interface Props { lang?: Locale }
const { lang = 'en' } = Astro.props;
const s = blogUi[lang].sidebar;
---
<aside class="blog-sidebar">
  <div class="blog-sidebar-card">
    <h3>{s.qH}</h3>
    <p>{s.qP}</p>
    <a class="link-arrow" href={l(lang, '/contact/')}>{s.qLink}</a>
  </div>
  <div class="blog-sidebar-card">
    <h3>{s.whatH}</h3>
    <p>{s.whatP}</p>
  </div>
</aside>
