---
// The English sidebar also links to the free checklist page (/checklist/), which collects an email through the Worker.
import { blogUi } from '../i18n/blog-ui';
import { l, type Locale } from '../i18n/config';
interface Props { lang?: Locale }
const { lang = 'en' } = Astro.props;
const s = blogUi[lang].sidebar;
---
<aside class="blog-sidebar">
  <div class="blog-sidebar-card">
    <h3>{s.qH}</h3>
    <p>{s.qP}</p>
    <a class="link-arrow" href={l(lang, '/contact/')}>{s.qLink}</a>
  </div>
  {lang === 'en' && (
    <div class="blog-sidebar-card">
      <h3>Free checklist</h3>
      <p>What to have ready before you hire a web designer, plus five questions to ask every studio.</p>
      <a class="link-arrow" href="/checklist/">Get the checklist</a>
    </div>
  )}
  <div class="blog-sidebar-card">
    <h3>{s.whatH}</h3>
    <p>{s.whatP}</p>
  </div>
</aside>
