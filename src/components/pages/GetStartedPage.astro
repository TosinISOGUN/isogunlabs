---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import { moreFor } from '../../i18n/more';
import { l, type Locale } from '../../i18n/config';

interface Props { lang: Locale }
const { lang } = Astro.props;
const m = moreFor(lang).getStarted;
const apps = [
  { sub: 'Recap for Jira Cloud', market: 'https://marketplace.atlassian.com/2146687861', page: 'https://recap.isogunlabs.com/', logo: '' },
  { sub: 'Field Hygiene for Jira Cloud', market: 'https://marketplace.atlassian.com/apps/2905942594', page: 'https://field-hygiene.isogunlabs.com/', logo: '/assets/field-hygiene-logo-144.png' },
  { sub: 'Passdown for JSM', market: 'https://marketplace.atlassian.com/apps/3571155481', page: 'https://passdown.isogunlabs.com/', logo: '/assets/passdown-logo-144.png' },
];
const path = l(lang, '/get-started/');
---
<BaseLayout
  title={m.title}
  description={m.description}
  path={path}
  breadcrumbs={[{ name: m.crumb, path }]}
>

<header class="page-head">
  <div class="wrap">
    <h1>{m.h1}</h1>
    <p class="lead">{m.lead}</p>
  </div>
</header>

<section class="section-tight" style="padding-top:0">
  <div class="wrap">
    <div class="chooser">
      {m.cards.map((c, i) => (
        <article class="chooser-card">
          <div class="chooser-label">{c.label}</div>
          <div class="top">
            <span class="ic" aria-hidden="true">
              {i === 0 ? <Fragment set:html={'<svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><path d="M146,96 H330 L366,132 V396 H146 Z" fill="#C2610C"/><path d="M330,96 L366,132 H330 Z" fill="#7C3A08"/><rect x="174" y="186" width="164" height="18" rx="9" fill="#FDE7C7"/><rect x="174" y="228" width="164" height="18" rx="9" fill="#E8C39E"/><rect x="174" y="270" width="100" height="18" rx="9" fill="#E8C39E"/><circle cx="360" cy="390" r="52" fill="#15803D" stroke="#FFF" stroke-width="10"/><polyline points="336,392 354,410 388,368" fill="none" stroke="#FFF" stroke-width="14" stroke-linecap="round" stroke-linejoin="round"/></svg>'} /> : <img src={apps[i].logo} alt="" width="56" height="56" />}
            </span>
            <div>
              <div class="sub">{apps[i].sub}</div>
              <h3>{c.h3}</h3>
            </div>
          </div>
          <p>{c.p}</p>
          <ul class="chooser-list">
            {c.list.map((x) => <li>{x}</li>)}
          </ul>
          <div class="chooser-actions">
            <a class="btn btn-ink btn-sm" href={apps[i].market} target="_blank" rel="noopener">{m.marketplace}</a>
            <a class="link-arrow" href={apps[i].page}>{m.product}</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="cta">
  <div class="wrap reveal">
    <h2>{m.ctaH2}</h2>
    <p class="lead" style="color:inherit;opacity:.8;max-width:48ch">{m.ctaP}</p>
    <div class="cta-row">
      <a class="btn btn-ink" href="mailto:support@isogunlabs.com">{m.email} <Icon name="arrow-right" /></a>
      <a class="mail" href={l(lang, '/documentation/')}>{m.docs}</a>
    </div>
  </div>
</section>

</BaseLayout>
