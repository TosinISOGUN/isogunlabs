---
import Seo from '../components/Seo.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import splash from '../data/pwa-splash.json';
import { pageLang } from '../i18n';
import { localeInfo } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  path: string;
  ogTitle?: string;
  ogDescription?: string;
  robots?: string;
  breadcrumbs?: { name: string; path: string }[];
  jsonLd?: object;
  preloadImage?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
}

const { lang, t } = pageLang(Astro.url.pathname);
const { title, description, path, robots, breadcrumbs, ogTitle, ogDescription, jsonLd, preloadImage, type, publishedTime, modifiedTime } = Astro.props;
---
<!doctype html>
<html lang={localeInfo[lang].htmlLang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="author" content="Isogun Labs">
<meta name="theme-color" content="#000000">

<Seo robots={robots} breadcrumbs={breadcrumbs} title={title} description={description} path={path} ogTitle={ogTitle} ogDescription={ogDescription} jsonLd={jsonLd} type={type} publishedTime={publishedTime} modifiedTime={modifiedTime} />

<link rel="alternate" type="application/rss+xml" title="Isogun Labs Blog" href="/rss.xml">

<!-- Google Search Console: verified via DNS TXT record at Porkbun (no meta tag needed). -->
<!-- Bing Webmaster Tools: verified via HTML meta tag. -->
<meta name="msvalidate.01" content="B763854E989D3089E737F531F7833BE5" />

<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/geist-variable.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/unbounded-latin.woff2" crossorigin>

{preloadImage && <link rel="preload" as="image" fetchpriority="high" href={preloadImage}>}

<link rel="icon" href="/favicon.ico" sizes="any"><link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/assets/icons/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/assets/icons/favicon-48.png" sizes="48x48" type="image/png">
<link rel="icon" href="/assets/icons/favicon-96.png" sizes="96x96" type="image/png">
<link rel="icon" href="/assets/icons/favicon-192.png" sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png?v=2">
<link rel="manifest" href="/site.webmanifest">

<!-- Installed app (home-screen) look. Android builds its launch screen from the manifest; iPhone and iPad need one
     image per screen size. The images come from scripts/build-pwa-assets.mjs. -->
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Isogun Labs">
<meta name="apple-mobile-web-app-status-bar-style" content="black">
{splash.map((s) => (
  <link rel="apple-touch-startup-image" href={`/assets/splash/splash-${s.w * s.dpr}x${s.h * s.dpr}.png`} media={`(device-width: ${s.w}px) and (device-height: ${s.h}px) and (-webkit-device-pixel-ratio: ${s.dpr}) and (orientation: portrait)`} />
))}

<!-- Google Analytics 4 is NOT loaded here. /assets/js/consent.js loads it only after the visitor accepts.
     Until then gtag() is a harmless no-op, so the event calls in the page scripts never fail and nothing is recorded. -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){ if (window.__gaOn) window.dataLayer.push(arguments); }
</script>

<script is:inline>document.documentElement.classList.add('js');</script>
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/bricolage-grotesque-latin.woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/site.css?v=14">
</head>
<body class={/^\/((fr|es|de|pt)\/)?$/.test(Astro.url.pathname) ? 'is-home' : undefined}>

<a class="skip" href="#main">{t.ui.skip}</a>

<Nav />

<main id="main">
  <slot />
</main>

<Footer />
<CookieBanner />

<script src="/assets/js/site.js?v=6" defer></script>
<script src="/assets/js/consent.js?v=2" defer></script>
</body>
</html>
