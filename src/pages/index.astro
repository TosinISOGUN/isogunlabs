---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import Icon from '../components/Icon.astro';
import ScreenshotSlider from '../components/ScreenshotSlider.astro';
import { getCollection } from 'astro:content';
import { ctaLabel, ctaHref, contact } from '../data/nav';

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const tech = [
  ['astro', 'Astro'], ['react', 'React'], ['typescript', 'TypeScript'], ['nodedotjs', 'Node.js'], ['tailwindcss', 'Tailwind CSS'],
  ['shopify', 'Shopify'], ['jira', 'Jira'], ['atlassian', 'Atlassian'], ['vercel', 'Vercel'], ['github', 'GitHub'],
];

const projects = [
  { slug: 'gloria-may-byron', name: 'Gloria May Byron', status: 'Live site', line: 'Website for an independent singer and songwriter, in twelve languages.', url: 'https://gloriamaybyron.com/', alt: 'Gloria May Byron website homepage' },
  { slug: 'velora-beauty', name: 'Velora Beauty', status: 'Concept project', line: 'Online beauty shop with a routine builder and a shopping bag.', url: 'https://velorabeautyy.vercel.app', alt: 'Velora Beauty concept store homepage' },
  { slug: 'hearthline-realty', name: 'Hearthline Realty', status: 'Concept project', line: 'Real estate site with home search, a map and showing requests.', url: 'https://hearthlinerealty.vercel.app', alt: 'Hearthline Realty concept site homepage' },
  { slug: 'juniper-ember', name: 'Juniper & Ember', status: 'Concept project', line: 'Restaurant site with a menu, pickup ordering and reservations.', url: 'https://juniperandember.vercel.app/', alt: 'Juniper and Ember concept restaurant homepage' },
  { slug: 'weseeu', name: 'weSEEu', status: 'In development', line: 'Therapy and special-needs marketplace with provider profiles and sign-up.', url: 'https://weseeu.vercel.app', alt: 'weSEEu marketplace homepage' },
];

const recapShots = [
  { src: '/assets/recap-report.png', width: 1522, height: 907, alt: 'Recap in Jira showing a generated monthly status report grouped by epic, ready to copy and paste.' },
  { src: '/assets/field-hygiene-01-duplicates.png', width: 1104, height: 540, alt: 'Field Hygiene in Jira showing grouped duplicate and near-duplicate custom field names.' },
  { src: '/assets/passdown-03-handoff.png', width: 915, height: 516, alt: 'Passdown in Jira showing an automated shift-handoff brief posted as a native comment with the incoming person mentioned.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': 'https://isogunlabs.com/#org',
      areaServed: 'Worldwide',
      serviceType: ['Website design and development', 'Web application development', 'E-commerce and booking systems', 'Atlassian Marketplace app development'],
      founder: { '@type': 'Person', '@id': 'https://isogunlabs.com/#founder', name: 'Oluwatomisin Isogun', jobTitle: 'Founder and lead developer', url: 'https://portfolio.isogunlabs.com', image: 'https://isogunlabs.com/assets/photos/founder.webp' },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Services',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Websites for businesses and brands', url: 'https://isogunlabs.com/services/#websites' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Web apps and MVPs for startups', url: 'https://isogunlabs.com/services/#web-apps' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Online stores and booking', url: 'https://isogunlabs.com/services/#stores-booking' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Atlassian Marketplace apps', url: 'https://isogunlabs.com/services/#marketplace-apps' } },
        ],
      },
      name: 'Isogun Labs',
      alternateName: 'Isogun Labs Studio',
      url: 'https://isogunlabs.com/',
      logo: 'https://isogunlabs.com/assets/icons/icon-512.png',
      image: 'https://isogunlabs.com/assets/og-image.png',
      description: 'Tech studio building websites, web apps and Atlassian Marketplace apps for startups, businesses and brands.',
      email: 'support@isogunlabs.com',
      slogan: 'Websites and software that ship.',
      knowsAbout: ['Website design and development', 'Web applications', 'E-commerce and booking systems', 'Atlassian Forge', 'Jira apps', 'Atlassian Marketplace', 'Shopify apps'],
      contactPoint: [
        { '@type': 'ContactPoint', email: 'tomisin@isogunlabs.com', contactType: 'sales' },
        { '@type': 'ContactPoint', email: 'support@isogunlabs.com', contactType: 'customer support' },
      ],
      sameAs: [
        'https://www.linkedin.com/company/isogun-labs',
        'https://x.com/isogunlabs',
        'https://www.instagram.com/isogunlabs/',
        'https://www.youtube.com/@isogun_labs',
        'https://portfolio.isogunlabs.com',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://isogunlabs.com/#website',
      url: 'https://isogunlabs.com/',
      name: 'Isogun Labs',
      description: 'Tech studio building websites, web apps and Atlassian Marketplace apps for startups, businesses and brands.',
      publisher: { '@id': 'https://isogunlabs.com/#org' },
      inLanguage: 'en',
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Recap - Monthly Status Reports for Jira',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Atlassian Jira Cloud',
      url: 'https://recap.isogunlabs.com/',
      installUrl: 'https://marketplace.atlassian.com/2146687861',
      downloadUrl: 'https://marketplace.atlassian.com/2146687861',
      description: 'Recap turns your completed Jira work from the last 30 days into a written monthly status report in one click, grouped by epic and ready to paste into a status update or performance review. Runs entirely on Atlassian and stores nothing.',
      publisher: { '@id': 'https://isogunlabs.com/#org' },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Field Hygiene for Jira',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Atlassian Jira Cloud',
      url: 'https://field-hygiene.isogunlabs.com/',
      installUrl: 'https://marketplace.atlassian.com/apps/2905942594',
      downloadUrl: 'https://marketplace.atlassian.com/apps/2905942594',
      description: 'Field Hygiene finds duplicate and near-duplicate custom fields, unused fields, and missing descriptions, plus a live read on how close a Jira site is to Atlassian field-count limits. All on one page, with zero setup.',
      publisher: { '@id': 'https://isogunlabs.com/#org' },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Passdown - Automated Shift Handoffs for JSM',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Atlassian Jira Service Management Cloud',
      url: 'https://passdown.isogunlabs.com/',
      installUrl: 'https://marketplace.atlassian.com/apps/3571155481',
      downloadUrl: 'https://marketplace.atlassian.com/apps/3571155481',
      description: 'Passdown reads what happened during a support shift and writes a plain-language handoff brief automatically at the shift boundary. It posts the brief as a comment, mentions and assigns the incoming person, and can summarize any single ticket on demand.',
      publisher: { '@id': 'https://isogunlabs.com/#org' },
    },
  ],
};
---
<BaseLayout
  title="Websites, Web Apps and Atlassian Apps | Isogun Labs"
  description="Isogun Labs is a tech studio that designs and builds websites, web apps and Atlassian Marketplace apps for startups, businesses and brands worldwide."
  path="/"
  ogDescription="A tech studio for startups, businesses and brands: websites, web apps and Atlassian Marketplace apps, designed and built end to end."
  jsonLd={jsonLd}
>

<section class="hero">
  <div class="wrap">
    <h1>We build websites and software that ship.</h1>
    <div class="hero-row">
      <p class="hero-sub">Isogun Labs is a tech studio for startups, businesses and brands, and for the Atlassian Marketplace.</p>
      <div class="hero-actions">
        <a class="btn btn-ink" href={ctaHref}>{ctaLabel} <Icon name="arrow-right" /></a>
        <a class="btn btn-line" href="/work/">See our work</a>
      </div>
    </div>
  </div>
  <nav class="hero-links" aria-label="What we build">
    <a href="/services/#websites"><span class="t">Websites</span><span class="d">For businesses and brands</span><Icon name="arrow-up-right" /></a>
    <a href="/services/#web-apps"><span class="t">Web apps</span><span class="d">MVPs and platforms</span><Icon name="arrow-up-right" /></a>
    <a href="/services/#stores-booking"><span class="t">Stores and booking</span><span class="d">Checkout and reservations</span><Icon name="arrow-up-right" /></a>
    <a href="/services/#marketplace-apps"><span class="t">Marketplace apps</span><span class="d">Jira and JSM, built on Forge</span><Icon name="arrow-up-right" /></a>
  </nav>
</section>

<section class="logos" aria-label="Technology we build with">
  <div class="logos-track">
    <ul>
      {tech.map(([slug, name]) => <li style={`--src:url(/assets/tech/${slug}.svg)`} role="img" aria-label={name}></li>)}
    </ul>
    <ul aria-hidden="true">
      {tech.map(([slug]) => <li style={`--src:url(/assets/tech/${slug}.svg)`}></li>)}
    </ul>
  </div>
</section>

<section class="section" id="services">
  <div class="wrap">
    <div class="reveal">
      <h2 class="h2">What we build</h2>
      <p class="lead">From a first website to a production app, one studio handles the design, the code and the launch.</p>
    </div>
    <div class="bento">
      <a class="cell cell-photo cell-a reveal" href="/services/#websites">
        <img src="/assets/photos/desk-sketch.webp" alt="" width="1600" height="1066" loading="lazy" decoding="async" />
        <div class="body">
          <h3>Websites for businesses and brands</h3>
          <p>Fast, mobile-first sites with booking, ordering and contact forms that turn visitors into customers.</p>
          <span class="link-arrow more">Websites <Icon name="arrow-up-right" /></span>
        </div>
      </a>
      <a class="cell cell-lime cell-b reveal" href="/services/#web-apps">
        <div class="body">
          <h3>Web apps and MVPs for startups</h3>
          <p>Accounts, dashboards and internal tools, built to launch quickly and grow with you.</p>
          <ul class="chips" aria-label="Built with">
            <li class="chip">React</li><li class="chip">TypeScript</li><li class="chip">Node.js</li>
          </ul>
          <span class="link-arrow more">Web apps <Icon name="arrow-up-right" /></span>
        </div>
      </a>
      <a class="cell cell-card cell-c reveal" href="/services/#stores-booking">
        <div class="pic"><img src="/assets/photos/shop-laptop.webp" alt="" width="1600" height="1066" loading="lazy" decoding="async" /></div>
        <div class="body">
          <h3>Online stores and booking</h3>
          <p>Storefronts, carts and checkout, plus booking and ordering flows for service businesses.</p>
          <span class="link-arrow more">Stores and booking <Icon name="arrow-up-right" /></span>
        </div>
      </a>
      <a class="cell cell-photo cell-d reveal" href="/services/#marketplace-apps">
        <img src="/assets/photos/devs-pair.webp" alt="" width="1600" height="1066" loading="lazy" decoding="async" />
        <div class="body">
          <h3>Atlassian Marketplace apps</h3>
          <p>Apps for Jira and Jira Service Management, built on Forge, from first prototype to approved listing.</p>
          <span class="link-arrow more">Marketplace apps <Icon name="arrow-up-right" /></span>
        </div>
      </a>
    </div>
  </div>
</section>

<section class="section bg-2" id="work">
  <div class="wrap reveal">
    <h2 class="h2">Recent work</h2>
    <p class="lead">Live sites and concept builds, each designed and coded from scratch.</p>
  </div>
  <div class="rail reveal" tabindex="0" aria-label="Recent projects, scroll sideways">
    {projects.map((p) => (
      <a class="proj" href="/work/">
        <div class="shot"><img src={`/assets/work/${p.slug}.webp`} alt={p.alt} width="1280" height="800" loading="lazy" decoding="async" /></div>
        <h3>{p.name}</h3>
        <p class="meta"><span class="status">{p.status}.</span>{p.line}</p>
      </a>
    ))}
  </div>
  <div class="wrap head-actions">
    <a class="btn btn-ink" href="/work/">All work <Icon name="arrow-right" /></a>
  </div>
</section>

<section class="section apps" id="atlassian">
  <div class="wrap apps-grid">
    <div class="reveal">
      <h2 class="h2 h2-wide">Three apps live on the Atlassian Marketplace</h2>
      <p class="lead">Small, privacy-first apps for Jira and Jira Service Management, built on Atlassian Forge. Each does one job and asks only for the access it needs.</p>
      <ul class="app-list">
        <li class="app">
          <span class="app-ic" aria-hidden="true">
            <svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><rect width="512" height="512" fill="#FFF3E2"/><path d="M146,96 H330 L366,132 V396 H146 Z" fill="#C2610C"/><path d="M330,96 L366,132 H330 Z" fill="#7C3A08"/><rect x="174" y="186" width="164" height="18" rx="9" fill="#FDE7C7"/><rect x="174" y="228" width="164" height="18" rx="9" fill="#E8C39E"/><rect x="174" y="270" width="100" height="18" rx="9" fill="#E8C39E"/><circle cx="360" cy="390" r="52" fill="#15803D" stroke="#FFF" stroke-width="10"/><polyline points="336,392 354,410 388,368" fill="none" stroke="#FFF" stroke-width="14" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <div>
            <h3>Recap</h3>
            <p>Monthly status reports from completed Jira work, in one click.</p>
            <div class="links"><a href="https://marketplace.atlassian.com/2146687861" target="_blank" rel="noopener">Marketplace</a><a href="https://recap.isogunlabs.com/">Docs and support</a></div>
          </div>
        </li>
        <li class="app">
          <span class="app-ic" aria-hidden="true"><img src="/assets/field-hygiene-logo-144.png" alt="" width="52" height="52" loading="lazy" /></span>
          <div>
            <h3>Field Hygiene</h3>
            <p>Finds duplicate, unused and undocumented custom fields on your Jira site.</p>
            <div class="links"><a href="https://marketplace.atlassian.com/apps/2905942594" target="_blank" rel="noopener">Marketplace</a><a href="https://field-hygiene.isogunlabs.com/">Docs and support</a></div>
          </div>
        </li>
        <li class="app">
          <span class="app-ic" aria-hidden="true"><img src="/assets/passdown-logo-144.png" alt="" width="52" height="52" loading="lazy" /></span>
          <div>
            <h3>Passdown</h3>
            <p>Writes shift handoff briefs for Jira Service Management support teams.</p>
            <div class="links"><a href="https://marketplace.atlassian.com/apps/3571155481" target="_blank" rel="noopener">Marketplace</a><a href="https://passdown.isogunlabs.com/">Docs and support</a></div>
          </div>
        </li>
      </ul>
      <div class="apps-foot"><a class="btn btn-lime" href="/get-started/">Choose an app <Icon name="arrow-right" /></a></div>
    </div>
    <div class="reveal">
      <ScreenshotSlider shots={recapShots} barLabel="Recap, Field Hygiene and Passdown in Jira" productUrl="/get-started/" productLabel="All apps" intervalMs={3600} />
    </div>
  </div>
</section>

<section class="section" id="process">
  <div class="wrap process-grid">
    <div class="sticky reveal">
      <h2 class="h2">How a project runs</h2>
      <p class="lead">Four phases, one point of contact, and no surprises about who is building your project.</p>
    </div>
    <ol class="verbs reveal">
      <li><h3>Discuss</h3><p>A free 20 minute call to understand the goal, the audience and what the site or app has to do.</p></li>
      <li><h3>Design</h3><p>Layouts and a clear structure you can react to before any code is written.</p></li>
      <li><h3>Build</h3><p>Fast, accessible code that works on every screen size, with your feedback built in along the way.</p></li>
      <li><h3>Launch</h3><p>Domain, hosting and handover. You own the finished result.</p></li>
    </ol>
  </div>
</section>

<section class="section bg-2" id="about">
  <div class="wrap about-grid">
    <div class="about-photo reveal">
      <img src="/assets/photos/team-table.webp" alt="A small group of people planning a project around a table with laptops and sketches." width="1600" height="1066" loading="lazy" decoding="async" />
    </div>
    <div class="about-copy reveal">
      <h2 class="h2">A small studio with a high bar</h2>
      <p>Isogun Labs is an independent studio. We have shipped client websites, web platforms and three apps on the Atlassian Marketplace, and we bring the same care to every project, whatever its size.</p>
      <p>You talk directly to the person building your project, so decisions are quick and nothing gets lost in a hand-off.</p>
      <div class="person">
        <img src="/assets/photos/founder.webp" alt="Oluwatomisin Isogun" width="68" height="68" loading="lazy" />
        <div><b>Oluwatomisin Isogun</b><span>Founder and lead developer</span></div>
      </div>
    </div>
  </div>
</section>

{latestPosts.length > 0 && (
  <section class="section" id="writing">
    <div class="wrap">
      <div class="reveal">
        <h2 class="h2">Latest writing</h2>
        <p class="lead">Practical notes on building websites, shipping apps and working on Atlassian.</p>
      </div>
      <div class="blog-grid reveal">
        {latestPosts.map((post) => <BlogCard post={post} />)}
      </div>
      <div class="head-actions"><a class="btn btn-ink" href="/blog/">Read the blog <Icon name="arrow-right" /></a></div>
    </div>
  </section>
)}

<section class="cta">
  <div class="wrap reveal">
    <h2>Have a project in mind?</h2>
    <div class="cta-row">
      <a class="btn btn-ink" href={ctaHref}>{ctaLabel} <Icon name="arrow-right" /></a>
      <a class="mail" href={`mailto:${contact.projectEmail}`}>{contact.projectEmail}</a>
    </div>
  </div>
</section>

</BaseLayout>
