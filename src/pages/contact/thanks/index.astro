---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { contact } from '../../../data/nav';
---
<BaseLayout
  title="Thank You | Isogun Labs"
  description="Your brief has been sent to Isogun Labs."
  path="/contact/thanks/"
  robots="noindex, follow"
>

<header class="page-head">
  <div class="wrap">
    <h1>Thank you. We have your brief.</h1>
    <p class="lead">We will read it and reply by email. While you wait, you can book a call or look at our work.</p>
    <div class="ind-cta">
      <a class="btn btn-ink" href={contact.booking} target="_blank" rel="noopener" data-track="book_call">Book a free call <Icon name="arrow-right" /></a>
      <a class="btn btn-ghost-ink" href="/work/">See our work</a>
    </div>
  </div>
</header>

<section class="section-tight">
  <div class="wrap">
    <h2 class="h2">What happens next</h2>
    <ol class="steps">
      <li class="step"><span class="step-n">1</span><h3>We read it</h3><p>We go through what you wrote, and look at any sites you mentioned.</p></li>
      <li class="step"><span class="step-n">2</span><h3>We reply</h3><p>You get an email with questions, ideas and a suggested next step.</p></li>
      <li class="step"><span class="step-n">3</span><h3>We talk</h3><p>If it looks like a fit, we set up a short call and then write up a plan.</p></li>
    </ol>
  </div>
</section>

<script is:inline>
  if (typeof gtag === 'function') gtag('event', 'generate_lead', { method: 'enquiry_form' });
</script>

</BaseLayout>
