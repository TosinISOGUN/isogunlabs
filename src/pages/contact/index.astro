---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { contact } from '../../data/nav';

const subject = encodeURIComponent('New project enquiry');
const body = encodeURIComponent('Hi, I would like to talk about a project.\n\nWhat I need:\nWho it is for:\nPages or features:\nSites I like:\nWhen I need it:\n');
---
<BaseLayout
  breadcrumbs={[{ name: 'Start a project', path: '/contact/' }]}
  jsonLd={{ '@context': 'https://schema.org', '@graph': [{ '@type': 'ContactPage', '@id': 'https://isogunlabs.com/contact/#page', url: 'https://isogunlabs.com/contact/', name: 'Start a project', about: { '@id': 'https://isogunlabs.com/#org' } }] }}
  title="Get a Website Quote or Start a Project | Isogun Labs"
  description="Tell Isogun Labs about your website, web app or Atlassian Marketplace project. Send a short brief, book a free 20 minute call, or message us on WhatsApp."
  path="/contact/"
>

<header class="page-head">
  <div class="wrap">
    <h1>Start a project</h1>
    <p class="lead">Tell us what you need built. Book a free call, or send a short brief and we will reply by email.</p>
  </div>
</header>

<section class="section-tight" style="padding-top:0">
  <div class="wrap">
    <div class="contact-grid">
      <a class="ct ct-lime reveal" href={contact.booking} target="_blank" rel="noopener">
        <Icon name="calendar-blank" />
        <h2>Book a free call</h2>
        <p>Twenty minutes to talk through the goal, the audience and the next step.</p>
      </a>
      <a class="ct reveal" href={`mailto:${contact.projectEmail}?subject=${subject}&body=${body}`}>
        <Icon name="envelope-simple" />
        <h2>Send a brief</h2>
        <p>{contact.projectEmail}</p>
      </a>
      <a class="ct reveal" href={contact.whatsapp} target="_blank" rel="noopener">
        <Icon name="whatsapp-logo" />
        <h2>WhatsApp</h2>
        <p>A quick message to get the conversation started.</p>
      </a>
    </div>
    <section class="enq reveal" id="enquiry" aria-labelledby="enq-title">
      <div class="enq-intro">
        <h2 class="h2" id="enq-title">Send a brief</h2>
        <p class="lead">Tell us a little about the project. The more you share, the more useful our first reply will be.</p>
        <ul class="ticks">
          <li><Icon name="check" /><span>Free, and no obligation</span></li>
          <li><Icon name="check" /><span>We reply by email, in English</span></li>
          <li><Icon name="check" /><span>Clients in the USA, Canada, the UK and Europe</span></li>
        </ul>
      </div>
      <form class="enq-form" id="enquiry-form" method="post" novalidate data-endpoint={contact.formEndpoint} data-mailto={contact.projectEmail} data-thanks="/contact/thanks/">
        <div class="enq-row">
          <label class="f"><span>Your name <b aria-hidden="true">*</b></span><input name="name" type="text" autocomplete="name" required></label>
          <label class="f"><span>Email <b aria-hidden="true">*</b></span><input name="email" type="email" autocomplete="email" required></label>
        </div>
        <div class="enq-row">
          <label class="f"><span>Business or brand</span><input name="business" type="text" autocomplete="organization"></label>
          <label class="f"><span>Type of business</span>
            <select name="business_type">
              <option value="">Choose one</option>
              <option>Restaurant or cafe</option>
              <option>Clinic or practice</option>
              <option>Real estate</option>
              <option>Gym or fitness studio</option>
              <option>Beauty brand or salon</option>
              <option>Startup</option>
              <option>Other</option>
            </select>
          </label>
        </div>
        <div class="enq-row">
          <label class="f"><span>Where are you based?</span>
            <select name="country">
              <option value="">Choose one</option>
              <option>United States</option>
              <option>Canada</option>
              <option>United Kingdom</option>
              <option>Europe</option>
              <option>Somewhere else</option>
            </select>
          </label>
          <label class="f"><span>What do you need?</span>
            <select name="project_type">
              <option value="">Choose one</option>
              <option>A new website</option>
              <option>A website redesign</option>
              <option>An online store</option>
              <option>A web app or MVP</option>
              <option>An Atlassian Marketplace app</option>
              <option>Not sure yet</option>
            </select>
          </label>
        </div>
        <div class="enq-row">
          <label class="f"><span>When do you want it live?</span>
            <select name="timeline">
              <option value="">Choose one</option>
              <option>As soon as possible</option>
              <option>In 1 to 2 months</option>
              <option>In 3 months or more</option>
              <option>Just exploring</option>
            </select>
          </label>
          <label class="f"><span>Budget, if you have one in mind</span><input name="budget" type="text" placeholder="For example, $3,000 or a range"></label>
        </div>
        <label class="f"><span>About the project <b aria-hidden="true">*</b></span><textarea name="message" rows="5" required placeholder="What you want to build, who it is for, and any sites you like."></textarea></label>
        <p class="hp" aria-hidden="true"><label>Leave this empty <input name="_gotcha" type="text" tabindex="-1" autocomplete="off"></label></p>
        <input type="hidden" name="_subject" value="New project enquiry from isogunlabs.com">
        <div class="enq-actions">
          <button class="btn btn-ink" type="submit">Send brief <Icon name="arrow-right" /></button>
          <p class="enq-note">We use your details only to reply to this enquiry.</p>
        </div>
        <p class="enq-status" id="enquiry-status" role="status" aria-live="polite"></p>
      </form>
    </section>


    <div class="brief reveal">
      <h2 class="h2">What to include</h2>
      <ul class="ticks">
        <li><Icon name="check" /><span>What you want to build and why</span></li>
        <li><Icon name="check" /><span>Who it is for</span></li>
        <li><Icon name="check" /><span>The pages or features you already know you need</span></li>
        <li><Icon name="check" /><span>Websites you like, and what you like about them</span></li>
        <li><Icon name="check" /><span>When you need it live</span></li>
        <li><Icon name="check" /><span>Any text, photos or logos you already have</span></li>
      </ul>
    </div>

    <p class="work-note">Looking for help with one of our Atlassian apps? Email <a href={`mailto:${contact.supportEmail}`}>{contact.supportEmail}</a> or see <a href="/support/">Support and SLA</a>.</p>
  </div>
</section>

<script is:inline src="/assets/js/enquiry.js" defer></script>

</BaseLayout>
