---
import IndustryPage from '../../../components/pages/IndustryPage.astro';
import { industrySlugs } from '../../../i18n/config';

export function getStaticPaths() {
  return industrySlugs.map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
---
<IndustryPage lang="en" slug={slug!} />
