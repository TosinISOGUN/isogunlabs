---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCover from '../../../components/BlogCover.astro';
import BlogCard from '../../../components/BlogCard.astro';
import ShareBar from '../../../components/ShareBar.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, posts },
  }));
}

const { post, posts } = Astro.props;
const { Content } = await render(post);

const dateFmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const readingTime = Math.max(1, Math.round((post.body ?? '').trim().split(/\s+/).length / 200));

const readNext = posts
  .filter((p) => p.id !== post.id && !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

// Keep the page title near 60 characters: the brand suffix is only added when it fits.
const seoTitle = post.data.title.length + 14 <= 62 ? `${post.data.title} | Isogun Labs` : post.data.title;
const publishedTime = post.data.pubDate.toISOString();
const modifiedTime = (post.data.updatedDate ?? post.data.pubDate).toISOString();

const publisher = {
  '@type': 'Organization',
  name: 'Isogun Labs',
  url: 'https://isogunlabs.com/',
  logo: {
    '@type': 'ImageObject',
    url: 'https://isogunlabs.com/assets/icons/icon-512.png',
  },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: 'https://isogunlabs.com/assets/og-image.png',
  datePublished: publishedTime,
  dateModified: modifiedTime,
  author: { '@type': 'Person', name: 'Oluwatomisin Isogun', url: 'https://portfolio.isogunlabs.com' },
  publisher,
  isPartOf: { '@type': 'Blog', '@id': 'https://isogunlabs.com/blog/', name: 'Isogun Labs Blog' },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://isogunlabs.com/blog/${post.id}/`,
  },
};
---
<BaseLayout
  title={seoTitle}
  description={post.data.description}
  path={`/blog/${post.id}/`}
  jsonLd={jsonLd}
  breadcrumbs={[{ name: 'Blog', path: '/blog/' }, { name: post.data.title, path: `/blog/${post.id}/` }]}
  type="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
>

<header class="page-head">
  <div class="wrap">
    <div class="kicker"><a href="/blog/">Blog</a></div>
    <h1 style="max-width:20ch;font-size:clamp(2.2rem,5vw,4.2rem)">{post.data.title}</h1>
    <p class="post-meta">
      <time datetime={post.data.pubDate.toISOString()}>{dateFmt.format(post.data.pubDate)}</time>
      <span class="dot" aria-hidden="true"></span>
      <span>{readingTime} min read</span>
    </p>
  </div>
</header>

<section class="section-tight" style="padding-top:0">
  <div class="wrap">
    <div style="max-width:70ch; margin:0 auto; font-size:1.08rem;">
      <BlogCover variant={post.data.cover} size="lg" />
      <ShareBar url={`https://isogunlabs.com/blog/${post.id}/`} title={post.data.title} />
    </div>
    <article class="prose">
      <Content />
    </article>

    <aside class="prose post-cta">
      <h2>Need a website or app built?</h2>
      <p>Isogun Labs designs and builds websites, web apps and Atlassian Marketplace apps. See <a href="/services/">what we build</a>, browse <a href="/work/">recent work</a>, or <a href="/contact/">start a project</a>.</p>
    </aside>

    {readNext.length > 0 && (
      <div class="prose read-next">
        <div class="kicker">Read next</div>
        <div class="blog-grid">
          {readNext.map((p) => <BlogCard post={p} />)}
        </div>
      </div>
    )}
  </div>
</section>

</BaseLayout>
