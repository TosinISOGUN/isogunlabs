---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Page not found | Isogun Labs" description="The page you are looking for does not exist or has moved." path="/404.html" robots="noindex">
<section class="cta cta-first" style="min-height:70vh;display:grid;align-content:center">
  <div class="wrap">
    <p class="kicker" style="color:inherit;opacity:.7">Error 404</p>
    <h2>This page wandered off</h2>
    <p class="lead" style="color:inherit;opacity:.8">The page you are looking for does not exist or has moved.</p>
    <div class="cta-row">
      <a class="btn btn-ink" href="/">Back to the homepage <Icon name="arrow-right" /></a>
      <a class="mail" href="/work/">See our work</a>
    </div>
  </div>
</section>
</BaseLayout>
