<style>
  * { box-sizing:border-box; }
  body { margin:0; min-height:100vh; display:grid; place-items:center; padding:24px; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif; color:#fff; background:#000; line-height:1.6; text-align:center; }
  .topbar { position:fixed; top:0; left:0; right:0; height:5px; background:#fff; }
  .mark { width:58px; height:58px; margin:0 auto 26px; display:block; }
  .code { font-size:clamp(3.5rem,12vw,6rem); font-weight:800; letter-spacing:-.04em; margin:0; color:#fff; }
  h1 { font-size:1.5rem; font-weight:800; letter-spacing:-.02em; margin:6px 0 10px; }
  p { color:#C2C2C2; max-width:44ch; margin:0 auto 30px; }
  a.btn { display:inline-flex; align-items:center; gap:9px; text-decoration:none; font-weight:700; color:#000; background:#fff; padding:13px 26px; transition:transform .18s,background .2s; }
  a.btn:hover { transform:translateY(-2px); background:#E5E5E5; }
  a.btn svg { width:16px; height:16px; }
</style>
</head>
